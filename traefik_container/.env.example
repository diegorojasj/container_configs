# Docker socket path — for Podman use: /run/user/YOUR_UID/podman/podman.sock
SOCKET=/var/run/docker.sock
HOST=localhost
EMAIL=you@email.com
# Generate password hash: htpasswd -nbB [USER] [PASSWORD]
# Copy only the hash part (after the colon), no sed needed for .env files
USER=admin
PASSWORD=$2y$05$cB8I1gtClFlJlEYmdurKEuOeCXqVw0M7BFwXaqufPaGeVS.9BNlPq